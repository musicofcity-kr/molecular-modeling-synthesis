{
  "name": "molecule-modeling-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:single-html": "node scripts/build-single-html-mvp.mjs",
    "firebase:admin-env": "node scripts/prepare-firebase-admin-env.mjs",
    "firebase:teacher-claim": "node scripts/manage-teacher-claim.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"**/*.emulator.test.ts\" --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:firestore-rules": "npx firebase-tools@15.22.4 --config ../../firebase.json emulators:exec --only firestore --project demo-molecule-workbench \"vitest run src/services/firebase/firestoreRules.emulator.test.ts\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "3dmol": "^2.5.5",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.5.0",
    "ketcher-core": "^3.15.0",
    "ketcher-react": "^3.15.0",
    "ketcher-standalone": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
